rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: authenticated users can read all user profiles (for friend search) and write their own
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      
      // Personal subcollections (expenses, goals)
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }
      match /goals/{goalId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Groups collection: authenticated users can read/write shared groups and group expenses
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
      
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
